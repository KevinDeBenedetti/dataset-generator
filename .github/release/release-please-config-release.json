{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "chore", "section": "Chores", "hidden": false },
        { "type": "refactor", "section": "Code Refactoring", "hidden": false }
      ],
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='dataset-generator')].version" },
        { "type": "json", "path": "apps/next/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/next/openapi.json", "jsonpath": "$.info.version" },
        "apps/server/main.py"
      ]
    }
  }
}
