{
  "name": "next",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "predev": "bun run api:generate",
    "prebuild": "bun run api:generate",
    "pretypecheck": "bun run api:generate",
    "pretest": "bun run api:generate",
    "api:generate": "bun install --cwd openapi-codegen --frozen-lockfile && openapi-codegen/node_modules/.bin/openapi-ts",
    "api:watch": "bun install --cwd openapi-codegen --frozen-lockfile && OPENAPI_WATCH=1 OPENAPI_INPUT=\"${OPENAPI_INPUT:-${API_INTERNAL_URL:-${NEXT_PUBLIC_API_BASE_URL:-http://localhost:8000}}/openapi.json}\" openapi-codegen/node_modules/.bin/openapi-ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
