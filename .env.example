# Environment variables configuration
# Command: cp .env.example .env

# Docker Build Optimization
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Application ports
NEXT_HOST_PORT=
SERVER_HOST_PORT=

NEXT_PUBLIC_API_BASE_URL=

# PostgreSQL (the application database: users, refresh tokens, quality rules).
# These credentials seed the compose `postgres` service; the server builds its
# DATABASE_URL from them automatically. POSTGRES_HOST_PORT is the *host* mapping
# (project slot 2 → 5452) for psql / GUI clients — the server always connects
# in-network on 5432.
POSTGRES_USER=datasets
POSTGRES_PASSWORD=datasets
POSTGRES_DB=datasets
POSTGRES_HOST_PORT=5452
# Set only to point at a database outside compose (e.g. a managed Postgres);
# leave blank to use the compose service above. Must be a PostgreSQL URL.
DATABASE_URL=

# OpenAI provider
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VLM_MODEL=gpt-4o-mini

# Default target language
DEFAULT_TARGET_LANGUAGE=en

# Frontend / Integrations
VITE_API_BASE_URL=http://localhost:8000

# CRAWL4AI
CRAWL_MAX_DEPTH=
CRAWL_MAX_PAGES=
CRAWL_SAME_DOMAIN=
CRAWL_DELAY_SECONDS=

# Store generated pairs in Postgres and record a version (blank = true).
PERSIST_DATASETS=

SEED_DEV_USERS=true

# AUTH
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=
NEXT_PUBLIC_REFRESH_COOKIE_NAME=

# HUGGING FACE (dataset export — optional)
# A token with *write* access: https://huggingface.co/settings/tokens
# Exported dataset repos are always private.
HF_TOKEN=
# User or organization the repo is created under. Blank = the token's account.
HF_NAMESPACE=

# QDRANT
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=dev_
