# DatasetGen — copy to .env (`make env`). A blank value means "use the default".
# The local stack (`make dev`) needs nothing here but your own keys: compose
# fills in the database/Redis/Qdrant URLs, ENVIRONMENT=development and the
# public URLs from the ports. Production needs the "Production" block.

# ─── Environment ──────────────────────────────────────────────────────────────
# "development" locally. Anything else is production, which fails closed:
# secure __Host- cookies, SSO only, users' own keys only, and a refusal to
# boot until the production settings below are complete.
ENVIRONMENT=development

# ─── Production (required outside development) ────────────────────────────────
# Public https URL of the app. The API is served under it at /api, so the SSO
# callbacks to register are <FRONTEND_URL>/api/auth/{infomaniak,github}/callback.
FRONTEND_URL=
# Only when the API is not at <FRONTEND_URL>/api (compose sets it locally).
API_PUBLIC_URL=
# Signs the sessions. Random and long: openssl rand -hex 32
AUTH_SECRET_KEY=
# Encrypts the keys users store ("id:key,…", first encrypts). Generate with
#   python -m server.cli gen-key
# and back it up APART from the database: lose it and every user re-enters keys.
SECRETS_ENCRYPTION_KEYS=
# PostgreSQL URL (compose builds one from POSTGRES_* locally).
DATABASE_URL=
# Shared rate-limit store across replicas (compose: redis://redis:6379/0).
REDIS_URL=
# false when a deployment step runs the migrations instead (a Kubernetes Job,
# say): neither the API nor the worker does then.
RUN_MIGRATIONS_ON_STARTUP=true
# Behind a reverse proxy: its address, so rate limits see the real client IP.
FORWARDED_ALLOW_IPS=

# ─── Admin sign-in (/admin/login, required outside development) ───────────────
# The admin signs in with these secrets only; the account is made from them at
# start. The hash is argon2id:  python -m server.cli hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional: base32 secret for an authenticator app (6-digit codes).
ADMIN_TOTP_SECRET=
# Development only: the password in clear instead of the hash.
ADMIN_PASSWORD=
# The admin's Hugging Face token (blank: HF_TOKEN below). Its other keys are the
# server keys at the end of this file.
ADMIN_HF_TOKEN=

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# Infomaniak (OpenID Connect) — offered once both are set.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=
# GitHub OAuth App (github.com/settings/developers) — offered once both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated. These verified emails are admins, can always sign up and
# receive the data that predates multi-user ownership.
ADMIN_EMAILS=
# Email + password sign-in. Blank: on in development, off in production.
ENABLE_LOCAL_LOGIN=
# Sign-up, allowed domains and allowed LLM hosts are set in the backoffice
# (sign-up starts closed outside development until an admin opens it).

# ─── Models (an OpenAI-compatible endpoint: OpenAI, or a gateway like LiteLLM) ─
# Two models. Each user calls them with their own key and base URL (Settings).
# The LLM of every step: cleaning, Q&A generation, scoring, the dataset jobs and
# the transcription of uploaded PDF and image pages, so it must read images.
OPENAI_LLM_MODEL=gpt-4o-mini
# The embedding model (duplicate/grounding checks, vector collections), e.g.
# text-embedding-3-small or a gateway alias. Blank, or for a user whose
# endpoint doesn't serve it: the checks compare the words, and a collection
# can only use the other embedding models the endpoint lists.
OPENAI_EMBEDDING_MODEL=
# Sent to the LLM (default: low). Models that reject it, gpt-4o* among them: off.
OPENAI_REASONING_EFFORT=off
# Outside development: admins who saved no key of their own use OPENAI_BASE_URL
# + OPENAI_API_KEY below (e.g. an in-cluster LiteLLM with a virtual key).
# Other users always bring their own.
SERVER_LLM_FOR_ADMINS=false

# ─── Jobs ─────────────────────────────────────────────────────────────────────
# The `worker` service runs the queued jobs (without it they stay queued).
WORKER_CONCURRENCY=1
# Grace on SIGTERM; keep below the pod's terminationGracePeriodSeconds.
WORKER_DRAIN_SECONDS=25
# Per user, 0 = unlimited. A file or web page draft is not a worker run: it
# counts towards neither.
QUOTA_ACTIVE_RUNS=2
QUOTA_RUNS_PER_DAY=20
QUOTA_DATASETS=50

# ─── Storage ──────────────────────────────────────────────────────────────────
# Compose sets the URL locally; Qdrant is optional elsewhere.
QDRANT_URL=
QDRANT_API_KEY=
# Lets several environments share one Qdrant, each with its own prefix (blank:
# dataset_). The first to sweep orphaned collections claims the prefix; another
# environment with the same one then drops nothing, and logs an error.
QDRANT_COLLECTION_PREFIX=dev_
# Recipe runs' fetched files and draft Parquet: a directory (compose: the
# `drafts` volume). Per-user quota in bytes (default 2 GB) and how many days an
# unpublished draft is kept (default 14).
DRAFT_STORE_URL=
QUOTA_DRAFT_BYTES_PER_USER=
DRAFT_RETENTION_DAYS=
# The largest file a data source upload takes, in bytes (default 200 MB).
UPLOAD_MAX_BYTES=
# The tabular engine, per run: DuckDB memory limit (default 1GB), threads
# (default 2) and seconds a query may take (default 300).
ENGINE_MEMORY_LIMIT=
ENGINE_THREADS=
ENGINE_TIMEOUT_S=
# The tokens one model Q&A recipe run may spend, estimated before it starts
# (default 2000000).
QUOTA_TOKENS_PER_RUN=
# Store and version generated pairs (false = pass-through).
PERSIST_DATASETS=true

# ─── Resume page (admins only) ────────────────────────────────────────────────
# Reactive Resume: the instance's root (blank: rxresu.me) and a key of your
# account there.
REACTIVE_RESUME_URL=
REACTIVE_RESUME_API_KEY=

# ─── After a corpus publish (admins only) ─────────────────────────────────────
# The site that indexes the knowledge corpus: this URL is POSTed, with the
# secret as a bearer token, once an admin's corpus run has published. Both or
# nothing; outside development, https, or http to an in-cluster Service.
CORPUS_REINDEX_URL=
CORPUS_REINDEX_SECRET=

# ─── Local stack ──────────────────────────────────────────────────────────────
# Host ports (dev slot 2 by default): web 3020, API 8020, Postgres 5452,
# Qdrant 6353, Redis 6399.
NEXT_PORT=
SERVER_PORT=
POSTGRES_HOST_PORT=
QDRANT_HOST_PORT=
REDIS_HOST_PORT=
# Requires a password of the compose Redis (blank: open, on 127.0.0.1 only).
REDIS_PASSWORD=
# Credentials of the compose Postgres.
POSTGRES_USER=datasets
POSTGRES_PASSWORD=datasets
POSTGRES_DB=datasets
# The dev accounts admin@example.com / user@example.com: docker-compose.yml
# seeds them (set SEED_DEV_USERS=true here for `make dev-local`), with these
# passwords (blank: admin1234 / user1234, in development only).
DEV_ADMIN_PASSWORD=
DEV_USER_PASSWORD=
# Streams raw server logs into the browser (Ctrl+`). Never outside your machine.
DEBUG_LOGS=

# ─── Server keys — the development fallback ───────────────────────────────────
# Never used for users in production: there, each user saves their own — but
# for admins with SERVER_LLM_FOR_ADMINS=true, who call this endpoint with this
# key (always together: the key never goes to another URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Hugging Face token with WRITE access; published repos are always private.
HF_TOKEN=
# Completes a bare repo name (blank: the token's own account).
HF_NAMESPACE=
# The GitHub Q&A dataset, and the knowledge corpus ('namespace/name' or 'name').
HF_QA_DATASET_REPO=
HF_DATASET_REPO=
# The license written on the GitHub Q&A dataset's card (e.g. cc-by-4.0, or
# "other" with a link).
HF_QA_DATASET_LICENSE=
HF_QA_DATASET_LICENSE_LINK=
# The GitHub account the GitHub jobs read; a token only raises the API quota.
GITHUB_USERNAME=
GITHUB_TOKEN=
