# DatasetGen — copy to .env (`make env`). A blank value means "use the default".
# The local stack (`make dev`) needs nothing here but your own keys: compose
# fills in the database/Redis/Qdrant URLs, ENVIRONMENT=development and the
# public URLs from the ports. Production needs the "Production" block.

# ─── Environment ──────────────────────────────────────────────────────────────
# "development" locally. Anything else is production, which fails closed:
# secure __Host- cookies, SSO only, users' own keys only, no Claude provider,
# and a refusal to boot until the production settings below are complete.
ENVIRONMENT=development

# ─── Production (required outside development) ────────────────────────────────
# Public https URL of the app. The API is served under it at /api, so the SSO
# callbacks to register are <FRONTEND_URL>/api/auth/{infomaniak,github}/callback.
FRONTEND_URL=
# Only when the API is not at <FRONTEND_URL>/api (compose sets it locally).
API_PUBLIC_URL=
# Signs the sessions. Random and long: openssl rand -hex 32
AUTH_SECRET_KEY=
# Encrypts the keys users store ("id:key,…", first encrypts). Generate with
#   python -m server.cli gen-key
# and back it up APART from the database: lose it and every user re-enters keys.
SECRETS_ENCRYPTION_KEYS=
# PostgreSQL URL (compose builds one from POSTGRES_* locally).
DATABASE_URL=
# Shared rate-limit store across replicas (compose: redis://redis:6379/0).
REDIS_URL=
# false when a deployment step runs the migrations (Kubernetes pre-upgrade Job).
RUN_MIGRATIONS_ON_STARTUP=true
# Behind a reverse proxy: its address, so rate limits see the real client IP.
FORWARDED_ALLOW_IPS=

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# Infomaniak (OpenID Connect) — offered once both are set.
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=
# GitHub OAuth App (github.com/settings/developers) — offered once both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated. These verified emails are admins, can always sign up and
# receive the data that predates multi-user ownership.
ADMIN_EMAILS=
# Email + password sign-in. Blank: on in development, off in production.
ENABLE_LOCAL_LOGIN=
# Sign-up, allowed domains and allowed LLM hosts are set in the backoffice.

# ─── Models offered (each user calls them with their own key) ─────────────────
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sent to the QA model (default: low). gpt-4o* reject it: off.
OPENAI_REASONING_EFFORT=off
# Claude model ids offered in development/CI (blank: built-in list).
CLAUDE_MODELS=

# ─── Jobs ─────────────────────────────────────────────────────────────────────
# The `worker` service runs the queued jobs (without it they stay queued).
WORKER_CONCURRENCY=1
# Grace on SIGTERM; keep below the pod's terminationGracePeriodSeconds.
WORKER_DRAIN_SECONDS=25
# Per user, 0 = unlimited.
QUOTA_ACTIVE_RUNS=2
QUOTA_RUNS_PER_DAY=20
QUOTA_DATASETS=50

# ─── Storage ──────────────────────────────────────────────────────────────────
# Compose sets the URL locally; Qdrant is optional elsewhere.
QDRANT_URL=
QDRANT_API_KEY=
# Lets several environments share one Qdrant.
QDRANT_COLLECTION_PREFIX=dev_
# Store and version generated pairs (false = pass-through).
PERSIST_DATASETS=true

# ─── Local embeddings (semantic dedup, grounding) ─────────────────────────────
SEMANTIC_ENABLED=true
SEMANTIC_MODEL=
SEMANTIC_DEDUP_THRESHOLD=
ANSWER_GROUNDING_THRESHOLD=
UNCOVERED_SECTION_THRESHOLD=

# ─── Local stack ──────────────────────────────────────────────────────────────
# Host ports (dev slot 2 by default): web 3020, API 8020, Postgres 5452,
# Qdrant 6353, Redis 6399.
NEXT_PORT=
SERVER_PORT=
POSTGRES_HOST_PORT=
QDRANT_HOST_PORT=
REDIS_HOST_PORT=
# Credentials of the compose Postgres.
POSTGRES_USER=datasets
POSTGRES_PASSWORD=datasets
POSTGRES_DB=datasets
# admin@example.com / user@example.com (weak defaults in development only).
SEED_DEV_USERS=true
DEV_ADMIN_PASSWORD=
DEV_USER_PASSWORD=
# Streams raw server logs into the browser (Ctrl+`). Never outside your machine.
DEBUG_LOGS=

# ─── Server keys — development fallback and the scheduled CI jobs only ────────
# Never used for users in production: there, each user saves their own.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Claude subscription (`claude setup-token`), or an Anthropic API key instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Model of the scheduled jobs: "<provider>:<model>" (default claude:claude-sonnet-5).
QA_JOB_MODEL=
# Hugging Face token with WRITE access; exported repos are always private.
HF_TOKEN=
HF_NAMESPACE=
HF_QA_DATASET_REPO=
HF_DATASET_REPO=
HF_QA_DATASET_LICENSE=
HF_QA_DATASET_LICENSE_LINK=
GITHUB_USERNAME=
GITHUB_TOKEN=
QA_FULL_REFRESH=false
