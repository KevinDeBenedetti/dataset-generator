# Fichiers système
*.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Git
.git
.gitignore

# IDE
.vscode
.idea

# Logs
*.log

# Local SQLite databases — must NOT be baked into the image, otherwise the
# container starts from a pre-existing DB and Alembic's create-tables migration
# hangs/fails instead of building a clean schema.
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
*.sqlite
*.sqlite3
**/*.sqlite
**/*.sqlite3

# Env — never bake secrets into an image layer (only the template is kept),
# at any depth: COPY ./apps/server would otherwise take an apps/server/.env.
**/.env*
!**/.env.example

# Agent state (worktrees, settings) — never part of an image.
.claude/

# Apps non nécessaires pour le server
apps/next

# Cache Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual env
.venv
venv
ENV
env

# Tests Python
.pytest_cache
.coverage
htmlcov
.tox

# Build Python
dist
build
*.egg-info

# Alembic
alembic/versions/*.pyc

# Documentation
*.md
!README.md

# Scripts locaux
scripts/
