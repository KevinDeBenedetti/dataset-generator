# Environment variables configuration
# Command: cp .env.example .env
#
# Blank = use the built-in default. Never commit the real .env.

# ─── Docker build ─────────────────────────────────────────────────────────────
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# ─── Ports (dev slot 2 — see ~/.claude/dev-ports.md) ──────────────────────────
NEXT_PORT=3020
SERVER_PORT=8020
# The browser-facing API URL must match the API's host port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8020
# Where the Next server reaches the API in-network (compose service name).
API_INTERNAL_BASE_URL=http://server:8000

# ─── Environment ──────────────────────────────────────────────────────────────
# development = local dev only: allows the dev secrets, local login and the
# Claude subscription provider. Anything else (or unset) is production: the
# server then refuses to start unless the production block below is complete.
ENVIRONMENT=development
SEED_DEV_USERS=true
# Streams server logs into an in-browser console. NEVER in shared environments.
DEBUG_LOGS=

# ─── PostgreSQL (application database) ────────────────────────────────────────
# These seed the compose `postgres` service; the server builds its DATABASE_URL
# from them. POSTGRES_HOST_PORT is the host mapping for psql / GUI clients.
POSTGRES_USER=datasets
POSTGRES_PASSWORD=datasets
POSTGRES_DB=datasets
POSTGRES_HOST_PORT=5452
# Only to point at a database outside compose (managed Postgres). PostgreSQL URL.
DATABASE_URL=

# ─── Qdrant / Redis ───────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=dev_
QDRANT_HOST_PORT=6353
# Shared rate-limiter store (blank = in-process limiter).
REDIS_URL=
REDIS_HOST_PORT=6399

# ─── Authentication ───────────────────────────────────────────────────────────
# Production: two different random secrets (openssl rand -hex 32).
AUTH_SECRET_KEY=
SESSION_SECRET_KEY=
# Local email+password sign-in. On in development, off elsewhere (SSO only).
ENABLE_LOCAL_LOGIN=
AUTH_TOKEN_TTL_SECONDS=
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Cookie names: blank in development; production uses the __Host- defaults.
AUTH_COOKIE_NAME=
AUTH_REFRESH_COOKIE_NAME=
# Production only: true (cookies are __Host- prefixed, https only).
AUTH_COOKIE_SECURE=
# Public https URL of the app (production) / the front in development.
FRONTEND_URL=http://localhost:3020
CORS_ALLOW_ORIGINS=

# ─── Single sign-on ───────────────────────────────────────────────────────────
# Callbacks: <api>/auth/infomaniak/callback and <api>/auth/github/callback
# (production: https://<host>/api/auth/<provider>/callback).
# Infomaniak (OpenID Connect)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8020/auth/oidc/callback
# GitHub (OAuth App: github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8020/auth/github/callback
# Comma-separated. These verified emails are admins, may always sign up, and
# receive the data that predates multi-user ownership.
ADMIN_EMAILS=
ALLOW_SIGNUP=true
ALLOWED_EMAIL_DOMAINS=
# Providers whose verified email may attach a sign-in to an existing account.
SSO_TRUSTED_EMAIL_PROVIDERS=infomaniak,github

# ─── Per-user keys (Settings page) ────────────────────────────────────────────
# Key ring "id:key,id:key" (first encrypts). REQUIRED in production:
#   python -m server.cli gen-key
# Back it up APART from the database. Development derives a key from AUTH_SECRET_KEY.
SECRETS_ENCRYPTION_KEYS=
# Fill what a user hasn't entered from the server's own keys below. Development
# convenience; must be false in production (blank = true in dev, false otherwise).
ALLOW_ENV_CREDENTIALS=
# Extra hosts a user's OpenAI-compatible base URL may use (besides api.openai.com).
ALLOWED_LLM_HOSTS=
ALLOW_CUSTOM_BASE_URL=false
# The Claude subscription provider exists in local dev and CI ONLY: do not set
# ENABLE_CLAUDE_PROVIDER in production (the server refuses to start).

# ─── Server-side fallback keys (development / CI only) ────────────────────────
# Used when ALLOW_ENV_CREDENTIALS is on, and by the scheduled GitHub Actions jobs.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VLM_MODEL=gpt-4o-mini
# Sent to the QA model (default: low). gpt-4o* reject it, so off here.
OPENAI_REASONING_EFFORT=off
# Claude subscription (dev / CI): `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODELS=
# Hugging Face: a token with *write* access. Exported repos are always private.
HF_TOKEN=
HF_NAMESPACE=
GITHUB_USERNAME=
GITHUB_TOKEN=
HF_QA_DATASET_REPO=
HF_DATASET_REPO=

# ─── Generation ───────────────────────────────────────────────────────────────
DEFAULT_TARGET_LANGUAGE=en
# Store generated pairs in Postgres and record a version (blank = true).
PERSIST_DATASETS=
# Local embeddings (semantic dedup, grounding): blank = defaults.
SEMANTIC_ENABLED=
SEMANTIC_DEDUP_THRESHOLD=
ANSWER_GROUNDING_THRESHOLD=
UNCOVERED_SECTION_THRESHOLD=

# ─── Job workers and quotas ───────────────────────────────────────────────────
# The `worker` compose service runs queued jobs; without it they stay queued.
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_SECONDS=120
WORKER_DRAIN_SECONDS=25
# Per user (0 = unlimited).
QUOTA_ACTIVE_RUNS=2
QUOTA_RUNS_PER_DAY=20
QUOTA_DATASETS=50
