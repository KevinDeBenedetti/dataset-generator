# Environment variables configuration
# Command: cp .env.example .env

# Docker Build Optimization
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Application ports
NEXT_HOST_PORT=
SERVER_HOST_PORT=

NEXT_PUBLIC_API_BASE_URL=

# OpenAI provider
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VLM_MODEL=gpt-4o-mini

# Default target language
DEFAULT_TARGET_LANGUAGE=en

# Langfuse (optional — app runs fine if Langfuse is down / unset)
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key-here
LANGFUSE_HOST=https://langfuse.example.com

# Frontend / Integrations
VITE_API_BASE_URL=http://localhost:8000
OWUI_URL=
OWUI_TOKEN=

# CRAWL4AI
CRAWL_MAX_DEPTH=
CRAWL_MAX_PAGES=
CRAWL_SAME_DOMAIN=
LANGFUSE_AUTO_SYNC=
CRAWL_DELAY_SECONDS=

SEED_DEV_USERS=true

# AUTH
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=
NEXT_PUBLIC_REFRESH_COOKIE_NAME=

# QDRANT
QDRANT_URL=http://qdrant:6333 
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=dev_
